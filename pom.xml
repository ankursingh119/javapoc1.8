<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.salesbatch</groupId>
  <artifactId>sales-batch-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>sales-batch-parent</name>

  <modules>
    <module>common</module>
    <module>spark-job</module>
    <module>workflow-app</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>1.8</java.version>

    <!-- spark-job builds on Spark 3.5.5 and Scala 2.12.18, still Java 8 class files (card SBJ17-11). The HBase client
         is 2.5 (card SBJ17-14) and needs an HBase 2 server; the provided Hadoop 2.10.1 client stays. EMR 5.36 runs
         neither Spark 3.5 nor HBase 2, so the production cluster must move before this is released there (risk
         SBJ17-12). -->
    <scala.version>2.12.18</scala.version>
    <scala.binary.version>2.12</scala.binary.version>
    <spark.version>3.5.5</spark.version>
    <hbase.version>2.5.10</hbase.version>
    <hadoop.version>2.10.1</hadoop.version>
    <!-- Spring 5.3, the javax line (card SBJ17-9). Spring 6 leaves javax and needs JDK 17 class files: not this card. -->
    <spring.version>5.3.39</spring.version>
    <activiti.version>5.22.0</activiti.version>
    <jackson.version>2.9.10.8</jackson.version>
    <jetty.version>9.4.44.v20210927</jetty.version>
    <h2.version>1.4.197</h2.version>
    <slf4j.version>1.7.30</slf4j.version>
    <junit.version>4.13.2</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.example.salesbatch</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>junit</groupId>
        <artifactId>junit</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- Coverage: "mvn test" writes <module>/target/site/jacoco/index.html (and jacoco.csv) for each module. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.8.1</version>
          <configuration>
            <source>${java.version}</source>
            <target>${java.version}</target>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>2.22.2</version>
          <configuration>
            <!-- Some workflow-app test classes set report.dir before the cached Spring context starts and
                 others do not, so the result depends on class order. Alphabetical is the order they pass in;
                 the default (filesystem) order differs on Linux.
                 This hides the order dependence; it is tracked as risk SBJ17-5 on the SBJ17 board
                 (card SBJ17-2, docs/cards/SBJ17-2.md). Remove this line when the tests no longer depend on order. -->
            <runOrder>alphabetical</runOrder>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.2.4</version>
        </plugin>
        <plugin>
          <groupId>net.alchim31.maven</groupId>
          <artifactId>scala-maven-plugin</artifactId>
          <version>4.8.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Built on JDK 9 or later (the JDK 17 job), javac gets release 8: Java 8 class files, as spark-job on JDK 8
         and Spark 2.4 need for common, and any JDK 9+ API is refused at compile time. On JDK 8, source and target
         1.8 as before. Card SBJ17-9, docs/cards/SBJ17-9.md. -->
    <profile>
      <id>release-8-on-jdk9-plus</id>
      <activation>
        <jdk>[9,)</jdk>
      </activation>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-compiler-plugin</artifactId>
              <configuration>
                <release>8</release>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>
</project>
